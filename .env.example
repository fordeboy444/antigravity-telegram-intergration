# ==============================================================================
# Antigravity Telegram Suite - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your configuration:
#   cp .env.example .env
# Or run the interactive setup wizard:
#   npm run setup
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Credentials & Access Control (REQUIRED)
# ------------------------------------------------------------------------------

# Telegram Bot API Token obtained from @BotFather on Telegram.
# Instructions:
# 1. Open Telegram and start a chat with @BotFather (https://t.me/BotFather)
# 2. Send /newbot and follow the prompts to choose a name and username.
# 3. Copy the HTTP API token provided by BotFather below.
BOT_TOKEN=your_telegram_bot_token_here

# Authorized Telegram User / Chat ID(s).
# For single user: 123456789
# For multiple users: 123456789,987654321
#
# Instructions to find your Chat ID:
# 1. Start a chat with @userinfobot on Telegram, OR
# 2. Run the bot in setup mode (`tg-ctl start`) and send `/start` from your Telegram account.
ALLOWED_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 2. Language & Localization
# ------------------------------------------------------------------------------

# Interface language for Telegram messages, command responses, inline keyboard
# buttons, and status alerts.
# Supported options:
#   en - English
#   zh - Simplified Chinese (简体中文)
#   ko - Korean (한국어)
#   tr - Turkish (Türkçe)
#   de - German (Deutsch)
#   es - Spanish (Español)
#   fr - French (Français)
LANGUAGE=en

# ------------------------------------------------------------------------------
# 3. Default AI Model & Quota Filter
# ------------------------------------------------------------------------------

# Default AI model selected on startup, new chats, and headless tasks.
# Common models:
#   - Gemini 3.5 Flash (Medium)  [Balanced / Fast]
#   - Gemini 3.5 Flash (High)    [High-quality Flash]
#   - Gemini 3.1 Pro (High)      [Complex Reasoning]
#   - Claude Sonnet 4.6 (Thinking)
#   - Claude Opus 4.6 (Thinking)
DEFAULT_MODEL=Gemini 3.5 Flash (Medium)

# Quota Display Filter for /getinfo
# Controls which model quotas appear in the /getinfo command output.
# Comma-separated list matching model displayName substrings (case-insensitive).
# Leave blank to display all available models.
QUOTA_DISPLAY_MODELS=Claude Opus 4.6,Claude Sonnet 4.6,Gemini 3.5 Flash (High),Gemini 3.5 Flash (Low),Gemini 3.5 Flash (Medium),Gemini 3.1 Pro (High),Gemini 3.1 Pro (Low)

# ------------------------------------------------------------------------------
# 4. CDP Remote Debugging Ports
# ------------------------------------------------------------------------------

# Chrome DevTools Protocol (CDP) debugging ports used to attach to running
# Antigravity instances. Must match the `--remote-debugging-port` argument.

# Standalone Antigravity Agent CDP port (default: 9333)
AGENT_CDP_PORT=9333

# Antigravity IDE CDP port (default: 9334)
IDE_CDP_PORT=9334

# Legacy single debugging port fallback (maps to agent port if AGENT_CDP_PORT not set)
DEBUGGING_PORT=9333

# ------------------------------------------------------------------------------
# 5. Workspaces & Upload Directories
# ------------------------------------------------------------------------------

# Root workspace / projects directory where repositories and projects reside.
# Used by Orca Terminal and CLI drivers for session discovery, commands, and worktrees.
# Defaults to ~/Projects or the current working directory.
PROJECTS_DIR=/home/user/Projects
ORCA_WORKSPACE_DIR=/home/user/Projects

# Temporary directory for file downloads, artifacts, screenshots, and logs
# before uploading to Telegram. Defaults to the OS temporary directory.
TELEGRAM_UPLOAD_DIR=/tmp/telegram-uploads

# ------------------------------------------------------------------------------
# 6. Application Driver & Automation Settings
# ------------------------------------------------------------------------------

# Preferred active application driver target:
#   ide           - Antigravity IDE (via CDP port 9334)
#   agent         - Standalone Antigravity Agent (via CDP port 9333)
#   orca_terminal - Orca Headless Terminal / CLI session driver
ANTIGRAVITY_PREFERRED_APP=ide

# Automatically approve/accept tool execution prompts when the bot starts
AUTOACCEPT_DEFAULT=true

# Project Memory Convention:
# When enabled, switching workspaces (/workspace) ensures the target project has a
# lightweight "Project Memory" section in its AGENT.md / CLAUDE.md / GEMINI.md.
AUTO_MEMORY_CONVENTION=false

# ------------------------------------------------------------------------------
# 7. Google OAuth Credentials (Optional - for /login and Google Workspace)
# ------------------------------------------------------------------------------

# Google OAuth 2.0 Client credentials for Google Workspace / Drive authentication.
# Leave blank or fill in your OAuth Client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ------------------------------------------------------------------------------
# 8. Telegraph / Instant-View Publishing
# ------------------------------------------------------------------------------

# Enable publishing large artifacts, plans, and walkthroughs to Telegraph
# for rich Instant View rendering in Telegram. Set to false to send as plain text/files.
ENABLE_TELEGRAPH=true

# API host for Telegraph uploads. api.graph.org is the default community mirror.
# Switch to api.telegra.ph if graph.org is unreachable from your network.
TELEGRAPH_API_HOST=api.graph.org

# ------------------------------------------------------------------------------
# 9. Turbo Multi-Agent Orchestration Pipeline
# ------------------------------------------------------------------------------

# Model configurations for each phase of the Turbo Mode multi-agent pipeline.
# If a model hits quota limits or times out, the fallback model is automatically used.
TURBO_PHASE1_MODEL=Gemini 3.5 Flash (High)
TURBO_PHASE1_FALLBACK=Claude Opus 4.6 (Thinking)
TURBO_PHASE2_MODEL=Gemini 3.1 Pro (High)
TURBO_PHASE3_MODEL=Gemini 3.5 Flash (High)
TURBO_PHASE3_FALLBACK=Claude Opus 4.6 (Thinking)
TURBO_PHASE4_MODEL=Gemini 3.1 Pro (High)
TURBO_PHASE5_MODEL=Gemini 3.5 Flash (High)

# ------------------------------------------------------------------------------
# 10. Advanced / Custom Binary Paths (Optional)
# ------------------------------------------------------------------------------

# Custom executable paths (uncomment only if binaries are not in default system PATH)
# ANTIGRAVITY_AGENT_PATH=C:\Users\YourUsername\AppData\Local\Programs\Antigravity\Antigravity.exe
# ANTIGRAVITY_IDE_PATH=C:\Users\YourUsername\AppData\Local\Programs\Antigravity-IDE\Antigravity-IDE.exe
# ORCA_BINARY=/usr/local/bin/orca
# AGY_PATH=/usr/local/bin/agy
